# Copy to .env.local. The publishable key is designed to be public (it ships to the browser):
# every table has row level security on and the anon/authenticated roles hold no privileges.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_API_URL=http://localhost:8000
